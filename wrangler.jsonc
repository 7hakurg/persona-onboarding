{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "persona-onboarding",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/auth/*", "/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ONBOARDING_AGENT", "class_name": "OnboardingAgent" },
      { "name": "BUDGET", "class_name": "BudgetDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OnboardingAgent", "BudgetDO"] }],
  "ratelimits": [
    { "name": "SESSION_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SOCKET_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
